#Использовать logos
#Использовать semver

Перем Лог;                        // Объект       - объект записи лога приложения
Перем ИмяМаркера;                 // Строка       - имя файла-маркера EDT (в нижнем регистре)
Перем ЭтоWindows;                 // Булево       - Истина - скрипт выполняется в среде Windows

#Область ПрограммныйИнтерфейс

// Функция - выполняет поиск установленной версии EDT и возвращает информацию о ней
//
// Параметры:
//  ВерсияEDT        - Строка - версия EDT (например "2024.1.2"), если не задана - выбирается максимальная
//  ПредпочитатьLite - Булево - Истина - при совпадении номеров обычной и Lite-версии выбирать Lite
//
// Возвращаемое значение:
//  Структура - информация о найденной установке EDT:
//    * КаталогEDT    - Строка - каталог выбранной установки EDT
//    * ВерсияEDT     - Строка - полная фактически выбранная версия EDT
//    * ПутьКcli      - Строка - полный путь к 1cedtcli / 1cedtcli.exe (пустая строка, если файл не найден)
//    * ЭтоLite       - Булево - Истина - выбрана Lite-версия EDT
//
Функция НайтиИнформациюОEDT(Знач ВерсияEDT = "", Знач ПредпочитатьLite = Ложь) Экспорт

	ВерсияEDT = СокрЛП(ВерсияEDT);

	// Валидация входного параметра ВерсияEDT
	Если ЗначениеЗаполнено(ВерсияEDT) Тогда
		ПроверитьФорматВерсии(ВерсияEDT);
		Лог.Отладка("Запрошена версия EDT: %1", ВерсияEDT);
	Иначе
		Лог.Отладка("Версия EDT не задана, будет выбрана максимальная");
	КонецЕсли;

	// сбор каталогов поиска
	КаталогиПоиска = КаталогиПоискаПоУмолчанию();

	Лог.Отладка("Каталоги поиска:");
	Для Каждого ТекКаталог Из КаталогиПоиска Цикл
		Лог.Отладка("  %1", ТекКаталог);
	КонецЦикла;

	// поиск маркеров
	НайденныеМаркеры = НайтиФайлыМаркеры(КаталогиПоиска);

	Если НайденныеМаркеры.Количество() = 0 Тогда

		Лог.Предупреждение("Не найдено ни одного маркера EDT в каталогах поиска");

		СтрокаКаталогов = "";
		Для Каждого ТекКаталог Из КаталогиПоиска Цикл
			СтрокаКаталогов = СтрокаКаталогов + Символы.ПС + "  - " + ТекКаталог;
		КонецЦикла;

		ВызватьИсключение "Не найдено ни одной установленной версии EDT. Проверенные каталоги:" + СтрокаКаталогов;

	КонецЕсли;

	Лог.Отладка("Найдено маркеров EDT: %1", НайденныеМаркеры.Количество());
	Для Каждого ТекМаркер Из НайденныеМаркеры Цикл
		Лог.Отладка("  %1", ТекМаркер);
	КонецЦикла;

	// чтение версий из файлов установок
	Установки = ПрочитатьУстановки(НайденныеМаркеры);

	Если Установки.Количество() = 0 Тогда
		ВызватьИсключение "Не найдено ни одной рабочей установки EDT: в каталогах с маркерами нет файлов установки"
			+ " или в configuration/config.ini не указан product.version";
	КонецЕсли;

	МассивВерсий = Новый Массив();
	Лог.Отладка("Найденные установки EDT:");
	Для Каждого ТекУстановка Из Установки Цикл
		Лог.Отладка("  %1%2 -> %3", ТекУстановка.Версия, ?(ТекУстановка.ЭтоLite, " (Lite)", ""), ТекУстановка.Каталог);
		Если МассивВерсий.Найти(ТекУстановка.Версия) = Неопределено Тогда
			МассивВерсий.Добавить(ТекУстановка.Версия);
		КонецЕсли;
	КонецЦикла;

	СортироватьВерсииПоУбыванию(МассивВерсий);

	// выбор целевой версии
	ВыбраннаяВерсия = ВыбратьВерсию(МассивВерсий, ВерсияEDT);
	Установка = ВыбратьУстановку(Установки, ВыбраннаяВерсия, ПредпочитатьLite);

	Лог.Отладка("Выбрана версия EDT: %1", ВыбраннаяВерсия);
	Лог.Отладка("Каталог установки: %1", Установка.Каталог);

	ПутьКcli = ОпределитьПутьК1cedtcli(Установка.Каталог);

	Результат = Новый Структура("КаталогEDT, ВерсияEDT, ПутьКcli, ЭтоLite",
		Установка.Каталог, ВыбраннаяВерсия, ПутьКcli, Установка.ЭтоLite);

	Возврат Результат;

КонецФункции // НайтиИнформациюОEDT()

#КонецОбласти // ПрограммныйИнтерфейс

#Область СлужебныеПроцедурыИФункции

// Функция - возвращает массив каталогов поиска EDT по умолчанию для текущей ОС
//
// Возвращаемое значение:
//  Массив(Строка) - каталоги поиска
//
Функция КаталогиПоискаПоУмолчанию()

	Каталоги = Новый Массив();

	Если ЭтоWindows Тогда

		ЛокальныйКаталог = ПолучитьПеременнуюСреды("LOCALAPPDATA");
		Если ЗначениеЗаполнено(ЛокальныйКаталог) Тогда
			Каталоги.Добавить(ОбъединитьПути(ЛокальныйКаталог, "1C", "1cedtstart", "installations"));
		КонецЕсли;

		ПрограмФайлз = ПолучитьПеременнуюСреды("ProgramW6432");
		Если НЕ ЗначениеЗаполнено(ПрограмФайлз) Тогда
			ПрограмФайлз = "C:\Program Files";
		КонецЕсли;
		Каталоги.Добавить(ОбъединитьПути(ПрограмФайлз, "1C", "1CE", "components"));

	Иначе

		ДомашнийКаталог = ПолучитьПеременнуюСреды("HOME");
		Если ЗначениеЗаполнено(ДомашнийКаталог) Тогда
			Путь = ОбъединитьПути(ДомашнийКаталог, ".local", "share", "1C");
			Путь = ОбъединитьПути(Путь, "1cedtstart", "installations");
			Каталоги.Добавить(Путь);
		КонецЕсли;

		Каталоги.Добавить(ОбъединитьПути("/opt", "1C", "1CE", "components"));

	КонецЕсли;

	Возврат Каталоги;

КонецФункции // КаталогиПоискаПоУмолчанию()

// Функция - рекурсивно ищет файлы-маркеры EDT в указанных каталогах
//
// Параметры:
//  КаталогиПоиска - Массив(Строка) - массив каталогов для сканирования
//
// Возвращаемое значение:
//  Массив(Строка) - массив путей к найденным файлам-маркерам
//
Функция НайтиФайлыМаркеры(Знач КаталогиПоиска)

	НайденныеМаркеры = Новый Массив();

	Для Каждого ТекКаталог Из КаталогиПоиска Цикл

		КаталогФС = Новый Файл(ТекКаталог);
		Если НЕ КаталогФС.Существует() ИЛИ НЕ КаталогФС.ЭтоКаталог() Тогда
			Лог.Отладка("Каталог не существует или не является каталогом: %1", ТекКаталог);
			Продолжить;
		КонецЕсли;

		Лог.Отладка("Сканирование каталога: %1", ТекКаталог);
		НайтиМаркерыВКаталоге(ТекКаталог, НайденныеМаркеры);

	КонецЦикла;

	Возврат НайденныеМаркеры;

КонецФункции // НайтиФайлыМаркеры()

// Функция - читает сведения об установке EDT из её файлов
//
// Параметры:
//  ПутьМаркера - Строка - полный путь к файлу-маркеру 1cedt.ini
//
// Возвращаемое значение:
//  Структура(Версия, Каталог, ЭтоLite, ЧерезСтартер) - сведения об установке
//  Неопределено                                      - каталог не является рабочей установкой EDT
//
Функция ПрочитатьУстановку(Знач ПутьМаркера)

	ФайлМаркера = Новый Файл(ПутьМаркера);
	Каталог = УбратьЗавершающийРазделитель(ФайлМаркера.Путь);
	ПутьConfigIni = ОбъединитьПути(Каталог, "configuration", "config.ini");

	// Проверка как у стартера EDT (EclipseProduct.isEclipseLayout):
	// остатки удалённых версий (например, только изменённый 1cedt.ini) её не проходят
	ОбязательныеФайлы = Новый Массив();
	ОбязательныеФайлы.Добавить(ПутьConfigIni);
	ОбязательныеФайлы.Добавить(ОбъединитьПути(Каталог, ".eclipseproduct"));
	ОбязательныеФайлы.Добавить(ОбъединитьПути(Каталог, ?(ЭтоWindows, "1cedt.exe", "1cedt")));

	Для Каждого ТекПуть Из ОбязательныеФайлы Цикл
		Если НЕ Новый Файл(ТекПуть).Существует() Тогда
			Лог.Отладка("Пропуск каталога (нет файла %1): %2", ТекПуть, Каталог);
			Возврат Неопределено;
		КонецЕсли;
	КонецЦикла;

	Версия = "";
	Для Каждого ТекСтрока Из СтрРазделить(ПрочитатьФайл(ПутьConfigIni), Символы.ПС) Цикл
		Если СтрНачинаетсяС(ТекСтрока, "product.version=") Тогда
			Версия = СокрЛП(Сред(ТекСтрока, СтрДлина("product.version=") + 1));
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Если НЕ ЭтоКорректнаяВерсия(Версия) Тогда
		Лог.Предупреждение("Пропуск установки EDT: в %1 не найден корректный product.version", ПутьConfigIni);
		Возврат Неопределено;
	КонецЕсли;

	// installation.setup есть только у установок через стартер,
	// Lite-версию отличает только код продукта в нём
	ПутьSetup = ОбъединитьПути(Каталог, "configuration", "org.eclipse.oomph.setup", "installation.setup");
	ЧерезСтартер = Новый Файл(ПутьSetup).Существует();
	ЭтоLite = ЧерезСтартер И СтрНайти(ПрочитатьФайл(ПутьSetup), "'epp.package.1cedt.light'") > 0;

	Возврат Новый Структура("Версия, Каталог, ЭтоLite, ЧерезСтартер", Версия, Каталог, ЭтоLite, ЧерезСтартер);

КонецФункции // ПрочитатьУстановку()

// Функция - читает текстовый файл целиком
//
// Параметры:
//  Путь - Строка - путь к файлу
//
// Возвращаемое значение:
//  Строка - содержимое файла
//
Функция ПрочитатьФайл(Знач Путь)

	Чтение = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8);
	Текст = Чтение.Прочитать();
	Чтение.Закрыть();

	Возврат Текст;

КонецФункции // ПрочитатьФайл()

// Функция - сортирует массив строк-версий по убыванию (от максимальной к минимальной)
//
// Параметры:
//  МассивВерсий - Массив(Строка) - массив версий для сортировки (изменяется на месте)
//
// Возвращаемое значение:
//  Массив(Строка) - отсортированный массив версий
//
Функция СортироватьВерсииПоУбыванию(МассивВерсий)

	Версии.СортироватьВерсии(МассивВерсий, "УБЫВ");

	Возврат МассивВерсий;

КонецФункции // СортироватьВерсииПоУбыванию()

// Процедура - рекурсивно ищет файлы-маркеры в указанном каталоге
//
// Параметры:
//  Каталог          - Строка          - каталог для поиска
//  НайденныеМаркеры - Массив(Строка)  - массив для накопления найденных маркеров
//
Процедура НайтиМаркерыВКаталоге(Знач Каталог, НайденныеМаркеры)

	Попытка
		НайденныеФайлы = НайтиФайлы(Каталог, "*", Ложь);
	Исключение
		Лог.Отладка("Ошибка доступа к каталогу: %1", Каталог);
		Возврат;
	КонецПопытки;

	Для Каждого ТекФайл Из НайденныеФайлы Цикл

		Если ТекФайл.ЭтоКаталог() Тогда
			// Рекурсивный спуск в подкаталоги
			НайтиМаркерыВКаталоге(ТекФайл.ПолноеИмя, НайденныеМаркеры);
		ИначеЕсли НРег(ТекФайл.Имя) = ИмяМаркера Тогда
			Лог.Отладка("Найден маркер: %1", ТекФайл.ПолноеИмя);
			НайденныеМаркеры.Добавить(ТекФайл.ПолноеИмя);
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры // НайтиМаркерыВКаталоге()

// Процедура - проверяет корректность формата версии EDT
//
// Параметры:
//  ВерсияEDT - Строка - версия EDT для проверки
//
Процедура ПроверитьФорматВерсии(Знач ВерсияEDT)

	Если НЕ ЭтоКорректнаяВерсия(ВерсияEDT) Тогда
		ВызватьИсключение "Некорректный формат версии EDT: """
			+ ВерсияEDT + """. Ожидается формат вида ""2024.1.2""";
	КонецЕсли;

КонецПроцедуры // ПроверитьФорматВерсии()

// Функция - проверяет, что строка является номером версии вида "2024.1.2"
//
// Параметры:
//  Версия - Строка - проверяемая строка
//
// Возвращаемое значение:
//  Булево - Истина - формат версии корректный
//
Функция ЭтоКорректнаяВерсия(Знач Версия)

	РегВыр = Новый РегулярноеВыражение("^\d+\.\d+(\.\d+)*$");

	Возврат РегВыр.Совпадает(Версия);

КонецФункции // ЭтоКорректнаяВерсия()

// Функция - читает сведения об установках EDT по найденным маркерам
//
// Параметры:
//  НайденныеМаркеры - Массив(Строка) - массив путей к файлам-маркерам
//
// Возвращаемое значение:
//  Массив(Структура) - рабочие установки EDT, см. ПрочитатьУстановку()
//
Функция ПрочитатьУстановки(Знач НайденныеМаркеры)

	Установки = Новый Массив();

	Для Каждого ТекМаркер Из НайденныеМаркеры Цикл
		Установка = ПрочитатьУстановку(ТекМаркер);
		Если Установка <> Неопределено Тогда
			Установки.Добавить(Установка);
		КонецЕсли;
	КонецЦикла;

	Возврат Установки;

КонецФункции // ПрочитатьУстановки()

// Функция - выбирает установку EDT выбранной версии
// Если установок этой версии несколько: обычная раньше Lite (или наоборот, если ПредпочитатьLite),
// офлайн-установка раньше установки через стартер
//
// Параметры:
//  Установки        - Массив(Структура) - рабочие установки EDT
//  Версия           - Строка            - выбранная версия
//  ПредпочитатьLite - Булево            - Истина - Lite раньше обычной
//
// Возвращаемое значение:
//  Структура - выбранная установка, см. ПрочитатьУстановку()
//
Функция ВыбратьУстановку(Знач Установки, Знач Версия, Знач ПредпочитатьLite)

	Выбранная = Неопределено;
	КоличествоУстановок = 0;

	Для Каждого ТекУстановка Из Установки Цикл
		Если ТекУстановка.Версия <> Версия Тогда
			Продолжить;
		КонецЕсли;
		КоличествоУстановок = КоличествоУстановок + 1;
		Если Выбранная = Неопределено
			ИЛИ ПриоритетУстановки(ТекУстановка, ПредпочитатьLite) < ПриоритетУстановки(Выбранная, ПредпочитатьLite) Тогда
			Выбранная = ТекУстановка;
		КонецЕсли;
	КонецЦикла;

	Если КоличествоУстановок > 1 Тогда
		Лог.Отладка("Найдено установок версии %1: %2, выбрана %3", Версия, КоличествоУстановок, Выбранная.Каталог);
	КонецЕсли;

	Возврат Выбранная;

КонецФункции // ВыбратьУстановку()

// Функция - возвращает приоритет установки при совпадении версий (меньше - приоритетнее)
//
// Параметры:
//  Установка        - Структура - установка EDT, см. ПрочитатьУстановку()
//  ПредпочитатьLite - Булево    - Истина - Lite раньше обычной
//
// Возвращаемое значение:
//  Число - приоритет: признак Lite важнее способа установки
//
Функция ПриоритетУстановки(Знач Установка, Знач ПредпочитатьLite)

	Возврат ?(Установка.ЭтоLite = ПредпочитатьLite, 0, 2) + ?(Установка.ЧерезСтартер, 1, 0);

КонецФункции // ПриоритетУстановки()

// Функция - выбирает целевую версию EDT из доступных
//
// Параметры:
//  МассивВерсий - Массив(Строка) - отсортированный по убыванию массив доступных версий
//  ВерсияEDT    - Строка          - запрошенная версия (пустая строка = максимальная)
//
// Возвращаемое значение:
//  Строка - выбранная версия
//
Функция ВыбратьВерсию(Знач МассивВерсий, Знач ВерсияEDT)

	Если НЕ ЗначениеЗаполнено(ВерсияEDT) Тогда
		// Выбираем максимальную версию (первый элемент после сортировки по убыванию)
		Лог.Отладка("Выбрана максимальная версия: %1", МассивВерсий[0]);
		Возврат МассивВерсий[0];
	КонецЕсли;

	// Проверяем, есть ли запрошенная версия среди доступных
	Если МассивВерсий.Найти(ВерсияEDT) <> Неопределено Тогда
		Возврат ВерсияEDT;
	КонецЕсли;

	// Укороченная версия (YYYY.M) - выбираем максимальную YYYY.M.*
	Если СтрЧислоВхождений(ВерсияEDT, ".") = 1 Тогда
		Для Каждого ТекВерсия Из МассивВерсий Цикл
			Если СтрНачинаетсяС(ТекВерсия, ВерсияEDT) Тогда
				Лог.Отладка("Укороченная версия %1 соответствует %2", ВерсияEDT, ТекВерсия);
				Возврат ТекВерсия;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	// Версия не найдена - исключение со списком доступных
	СтрокаВерсий = "";
	Для Каждого ТекВерсия Из МассивВерсий Цикл
		СтрокаВерсий = СтрокаВерсий + Символы.ПС + "  - " + ТекВерсия;
	КонецЦикла;

	ВызватьИсключение "Версия EDT " + ВерсияEDT + " не найдена. Доступные версии:" + СтрокаВерсий;

КонецФункции // ВыбратьВерсию()

// Функция - убирает завершающий разделитель пути (/ или \)
//
// Параметры:
//  Путь - Строка - путь к файлу или каталогу
//
// Возвращаемое значение:
//  Строка - путь без завершающего разделителя
//
Функция УбратьЗавершающийРазделитель(Знач Путь)

	Пока СтрДлина(Путь) > 1 И (Прав(Путь, 1) = "\" ИЛИ Прав(Путь, 1) = "/") Цикл
		Путь = Лев(Путь, СтрДлина(Путь) - 1);
	КонецЦикла;

	Возврат Путь;

КонецФункции // УбратьЗавершающийРазделитель()

// Функция - определяет полный путь к 1cedtcli в каталоге установки EDT
//
// Параметры:
//  КаталогEDT - Строка - каталог установки EDT
//
// Возвращаемое значение:
//  Строка - полный путь к 1cedtcli или пустая строка, если файл не найден
//
Функция ОпределитьПутьК1cedtcli(Знач КаталогEDT)

	ИмяФайла = ?(ЭтоWindows, "1cedtcli.exe", "1cedtcli");
	ПолныйПуть = ОбъединитьПути(КаталогEDT, ИмяФайла);
	ФайлCLI = Новый Файл(ПолныйПуть);

	Если ФайлCLI.Существует() Тогда
		Лог.Отладка("Найден 1cedtcli: %1", ПолныйПуть);
		Возврат ПолныйПуть;
	КонецЕсли;

	Лог.Отладка("1cedtcli не найден в каталоге: %1", КаталогEDT);
	Возврат "";

КонецФункции // ОпределитьПутьК1cedtcli()

#КонецОбласти // СлужебныеПроцедурыИФункции

#Область ОбработчикиСобытий

// Процедура - обработчик события "ПриСозданииОбъекта"
//
// BSLLS:UnusedLocalMethod-off
Процедура ПриСозданииОбъекта()

	Лог = Логирование.ПолучитьЛог("oscript.app.edtfind");

	СистемнаяИнформация = Новый СистемнаяИнформация;
	ЭтоWindows = Найти(НРег(СистемнаяИнформация.ВерсияОС), "windows") > 0;

	// 1cedt.ini есть в каждой рабочей установке, остальные файлы проверяются в ПрочитатьУстановку()
	ИмяМаркера = "1cedt.ini";

	Лог.Отладка("[ПоискEDT]: Объект инициализирован");

КонецПроцедуры // ПриСозданииОбъекта()
// BSLLS:UnusedLocalMethod-on

#КонецОбласти // ОбработчикиСобытий
